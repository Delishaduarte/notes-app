# Copy this file to ".env" for running on your laptop.

SECRET_KEY=change-this-to-any-long-random-text

# Local database (no AWS needed). Leave as is for now.
DATABASE_URL=sqlite:///local.db

# Leave empty until Carin gives you the bucket name.
S3_BUCKET=
AWS_REGION=ap-south-1

# Only on EC2: set to true to read DB + bucket from SSM Parameter Store.
USE_SSM=false
